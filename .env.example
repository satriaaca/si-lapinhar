# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Vercel Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional/Alternative for Groq Cloud (Llama 3.3 70B, Llama 3.1 8B, DeepSeek R1).
# Recommended to prevent quota limits when Gemini quota is exceeded (Error 429).
GROQ_API_KEY="gsk_..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
